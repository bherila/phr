APP_NAME="PHR"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# OAuth client credentials are provisioned in the server environment at deploy time.
OAUTH_PROVIDER=bherila
OAUTH_PROVIDER_URL=https://bherila.net
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI="${APP_URL}/oauth/callback"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local/dev default. Production uses its own MySQL database (`bherila_phr`,
# separate from the finance app's and games app's databases — see
# bherila/2025-website#1805) with credentials that live only in the server's
# .env, never in this repo.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Auth (bherila/auth-laravel) ---
# Passkeys (WebAuthn). RP ID must match the serving domain in production
# (phr.bherila.net); leave unset locally to fall back to the request host.
# WEBAUTHN_RP_NAME="${APP_NAME}"
# WEBAUTHN_ALLOWED_ORIGINS=
# WEBAUTHN_RESIDENT_KEY=preferred
# WEBAUTHN_USER_VERIFICATION=preferred
BHERILA_AUTH_AUDIT_DRIVER=database
BHERILA_AUTH_AUDIT_RETENTION_DAYS=
BHERILA_AUTH_THROTTLE_ENABLED=true

# --- GenAI (bherila/genai-laravel) ---
# Site-wide default provider/keys. Per-user overrides are managed via the
# /api/user/ai-prefs endpoints (UserAiConfiguration).
GENAI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
BEDROCK_API_KEY=
GEMINI_DAILY_REQUEST_LIMIT=500

# --- PHR ---
PHR_EXPORTS_RETENTION_DAYS=30
PHR_DOCUMENTS_RETENTION_DAYS=30
PHR_DICOM_MAX_FILE_BYTES=1073741824
PHR_DICOM_VIEWER_DIRECT_SIGNED_URLS=false
PHR_DICOM_VIEWER_URL_TTL_MINUTES=30
PHR_VOLUME_CACHE_PIPELINE_VERSION=1
PHR_VOLUME_CACHE_MAX_BYTES=67108864

# PHR DICOM object storage — dedicated Cloudflare R2 bucket, never the default
# S3 disk. Credentials live only in the server's .env; do not commit real values.
PHR_DICOM_DISK_DRIVER=s3
PHR_DICOM_R2_ACCESS_KEY_ID=
PHR_DICOM_R2_SECRET_ACCESS_KEY=
PHR_DICOM_R2_REGION=auto
PHR_DICOM_R2_BUCKET=
PHR_DICOM_R2_URL=
PHR_DICOM_R2_ENDPOINT=
PHR_DICOM_R2_USE_PATH_STYLE_ENDPOINT=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
