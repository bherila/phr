{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.5.0",
    "scripts": {
        "blobs": "bash scripts/blobs.sh",
        "build": "vite build",
        "dev": "vite",
        "test": "jest --passWithNoTests --maxWorkers=2",
        "test:e2e": "playwright test",
        "test:e2e:install": "playwright install --with-deps chromium",
        "validate:ccda": "node --test scripts/validate-ccda-process.test.mjs && node scripts/validate-ccda.mjs",
        "test:slow": "JEST_INCLUDE_SLOW_TESTS=1 jest --passWithNoTests --testPathPatterns='\\.slow\\.test\\.[tj]sx?$'",
        "type-check": "tsc --noEmit --jsx react-jsx",
        "lint": "eslint . --cache",
        "lint:fix": "eslint . --fix",
        "scan-sensitive": "node scripts/scan-sensitive.mjs"
    },
    "devDependencies": {
        "@eslint-react/eslint-plugin": "^5.18.1",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.62.1",
        "@swc/core": "^1.15.47",
        "@swc/jest": "^0.2.39",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.1.2",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@types/three": "^0.185.3",
        "@vitejs/plugin-react": "^6.0.5",
        "autoprefixer": "^10.5.4",
        "cda-schematron-validator": "1.1.12",
        "concurrently": "^10.0.4",
        "eslint": "^10.8.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^17.9.0",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "^30.4.1",
        "laravel-vite-plugin": "^3.1.3",
        "postcss": "^8.5.25",
        "tailwindcss": "^4.3.3",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.66.0",
        "vite": "^8.2.0"
    },
    "dependencies": {
        "@base-ui/react": "^1.6.0",
        "@cornerstonejs/codec-openjpeg": "^1.3.0",
        "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.4.0",
        "dicom-parser": "^1.8.21",
        "lucide-react": "^1.28.0",
        "pdfjs-dist": "6.2.108",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "recharts": "^3.10.1",
        "tailwind-merge": "^3.6.0",
        "three": "^0.185.1",
        "zod": "^4.4.3"
    }
}
