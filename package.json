        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.0.1",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@types/three": "^0.185.1",
        "@vitejs/plugin-react": "^6.0.3",
        "autoprefixer": "^10.5.2",
