{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.5.0",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test": "jest --passWithNoTests --maxWorkers=2",
