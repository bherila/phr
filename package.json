{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.11.2",
    "scripts": {
        "postinstall": "node scripts/spotlight-noindex.mjs",
        "blobs": "bash scripts/blobs.sh",
        "build": "vite build",
        "dev": "vite",
        "test": "jest --passWithNoTests --maxWorkers=2",
        "test:e2e": "playwright test",
        "test:e2e:install": "playwright install --with-deps chromium",
        "validate:ccda": "node --test scripts/validate-ccda-process.test.mjs && node scripts/validate-ccda.mjs",
        "test:slow": "JEST_INCLUDE_SLOW_TESTS=1 jest --passWithNoTests --testPathPatterns='\\.slow\\.test\\.[tj]sx?$'",
        "type-check": "tsc --noEmit --jsx react-jsx",
        "lint": "eslint . --cache",
        "lint:fix": "eslint . --fix",
        "scan-sensitive": "node scripts/scan-sensitive.mjs"
    },
    "devDependencies": {
        "@eslint-react/eslint-plugin": "^5.26.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.0",
        "@swc/core": "^1.16.18",
        "@swc/jest": "^0.2.39",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/three": "^0.186.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-react": "^6.1.2",
        "autoprefixer": "^10.6.1",
        "cda-schematron-validator": "1.1.12",
        "concurrently": "^10.0.6",
        "eslint": "^10.12.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^17.13.0",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "laravel-vite-plugin": "^3.2.0",
        "postcss": "^8.5.29",
        "spotlight-noindex": "1.1.1",
        "tailwindcss": "^4.3.3",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.71.1",
        "vite": "^8.3.4"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@cornerstonejs/codec-openjpeg": "^1.3.6",
        "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
        "bwh-auth": "0.4.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.4.0",
        "dicom-parser": "^1.8.21",
        "lucide-react": "^1.55.0",
        "pdfjs-dist": "6.4.299",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "recharts": "^3.10.1",
        "tailwind-merge": "^3.7.0",
        "three": "^0.186.1",
        "zod": "^4.6.6"
    }
}
